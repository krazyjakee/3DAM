{
  "name": "3dam-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "description": "3DAM web client — the browser front-end served by `3dam serve`.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm bundle:check",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:components": "pnpm test:components:typecheck && vitest run --coverage",
    "test:components:typecheck": "tsc -p tsconfig.test.json",
    "visual:responsive": "node scripts/capture-responsive-workspace.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && pnpm typecheck",
    "wasm": "cargo xtask wasm"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.11.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
