{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "docs/html"],
      "port": 4173
    },
    {
      "name": "3dam-serve",
      "runtimeExecutable": "target/release/3dam",
      "runtimeArgs": ["serve", "--addr", "127.0.0.1:7333"],
      "port": 7333
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web", "dev", "--port", "5273", "--strictPort"],
      "port": 5273
    },
    {
      "name": "web-auth-smoke",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_TARGET=http://127.0.0.1:7444", "pnpm", "--dir", "web", "dev", "--port", "5274", "--strictPort"],
      "port": 5274
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web", "dev"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
